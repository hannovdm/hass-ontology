### Initialize MCP session
# @name initialize
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": {
      "name": "vscode-rest-client",
      "version": "1.0"
    }
  }
}

### List available ontology tools
# @name listTools
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

### Analyze the impact of removing an entity
# @name impactAnalysis
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "impact_analysis",
    "arguments": {
      "target_type": "entity",
      "target": "office lights"
    }
  }
}

### Search the ontology
# @name searchOntology
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "search",
    "arguments": {
      "term": "office",
      "limit": 20
    }
  }
}

### Get context for an entity
# @name entityContext
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "entity_context",
    "arguments": {
      "entity": "sensor.temp_humidity_temperature"
    }
  }
}

### Find automations that depend on an entity
# @name automationDependencies
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/call",
  "params": {
    "name": "automation_dependencies",
    "arguments": {
      "entity": "office lights"
    }
  }
}

### Export a whole-home context summary
# @name exportWholeHome
POST {{$dotenv baseUrl}}
Authorization: Bearer {{$dotenv apiKey}}
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 7,
  "method": "tools/call",
  "params": {
    "name": "export_context",
    "arguments": {
      "export_type": "whole_home"
    }
  }
}

